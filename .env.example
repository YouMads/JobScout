# Optional local settings. Copy this file to .env; the defaults need no changes.
# Existing environment variables take precedence over this file.
JOBSCOUT_PORT=4317
JOBSCOUT_MODEL=qwen3:4b
JOBSCOUT_OLLAMA_URL=http://127.0.0.1:11434
# Relative cache paths are resolved from the project folder, not the terminal.
JOBSCOUT_DATA_DIR=data
# Optional Ollama executable if it is not on PATH. Used by the Windows launcher.
# JOBSCOUT_OLLAMA_BIN=C:/path/to/Ollama/ollama.exe
